AWS_REGION=ap-northeast-1
AWS_PROFILE=customer-ops-readonly
PERFORMANCE_ENVIRONMENT=production
PERFORMANCE_AGGREGATE_TABLE=customer-ops-performance-aggregate
PERFORMANCE_DETAIL_BUCKET=customer-ops-performance-detail
PERFORMANCE_CONSOLE_PORT=4318
PERFORMANCE_DEMO=false
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Sentry 只用于 issue 聚合与告警；性能指标仍走 DynamoDB/S3。留空则该面板显示未接入。
# Auth Token 在 Sentry 后台 Settings → Account → API → Auth Tokens 创建，只需 project:read。
SENTRY_BASE_URL=http://127.0.0.1:9000
SENTRY_AUTH_TOKEN=
SENTRY_ORG=sentry
SENTRY_PROJECT=customer-ops
SENTRY_TIMEOUT_MS=5000
