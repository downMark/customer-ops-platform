{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPerformanceAggregates",
      "Effect": "Allow",
      "Action": ["dynamodb:Query", "dynamodb:GetItem"],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/customer-ops-*-performance-aggregate",
        "arn:aws:dynamodb:*:*:table/customer-ops-*-performance-aggregate/index/environment-time-index"
      ]
    },
    {
      "Sid": "ListSanitizedPerformanceDetails",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::customer-ops-*-perf-*"
    },
    {
      "Sid": "ReadSanitizedPerformanceDetails",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::customer-ops-*-perf-*/environment=*"
    }
  ]
}
