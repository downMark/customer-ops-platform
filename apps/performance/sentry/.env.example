AWS_REGION=ap-northeast-1
AWS_PROFILE=customer-ops-readonly
PERFORMANCE_ENVIRONMENT=production
PERFORMANCE_DETAIL_BUCKET=
# Sentry 项目 DSN（Settings → Projects → <project> → Client Keys）。
# 走 envelope 端点而非 OTLP：本版本 Sentry 自托管没有 OTLP 摄入路由，且 OTLP 会落到
# errors-only profile 已裁掉的 span/transaction 管道，产不出 issue。
SENTRY_DSN=http://<public-key>@127.0.0.1:9000/<project-id>
# 单次同步最多处理的 S3 对象数；剩余部分由 checkpoint 在下次运行继续。
SENTRY_SYNC_MAX_OBJECTS=1000
