# Neon PostgreSQL 连接串（TLS 必需；Lambda 用 -pooler 主机名 + statement_cache_capacity=0）
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/customer_ops?sslmode=require

# JWT HS256 共享密钥（MVP 测试身份；生产改 JWKS/真实 IdP）
AUTH_JWT_SECRET=change-me-in-secrets-manager
# 登录 JWT 有效期（秒），默认 24 小时
AUTH_JWT_TTL_SECONDS=86400

# 监听端口（本地开发）
PORT=8080

# SNS Topic ARN（对话完成事件）。留空则用 no-op 发布器（本地无 AWS）。
# 生产用 IAM Role/Secrets 提供 AWS 凭证与区域（AWS_REGION 等）。
SNS_TOPIC_ARN=

# 日志级别
RUST_LOG=info,customer_ops_backend=debug
