MODEL_PATH=/Volumes/T7/customer-ops-model/customer-ops-q4_k_m.gguf
# 容器部署时，仅在 MODEL_PATH 不存在时从 S3 下载。
# MODEL_S3_URI=s3://customer-ops-models/models/customer-ops/customer-ops-q4_k_m.gguf
# 可选：发布时固定模型摘要，防止下载错误产物。
# MODEL_SHA256=
EMBEDDING_MODEL_PATH=/Volumes/T7/customer-ops-model/bge-m3-onnx/model.onnx
RERANK_MODEL_PATH=/Volumes/T7/customer-ops-model/bge-reranker-v2-m3-onnx/model.onnx
# EMBEDDING_MODEL_S3_URI=s3://customer-ops-models/models/customer-ops/bge-m3-onnx/
# RERANK_MODEL_S3_URI=s3://customer-ops-models/models/customer-ops/bge-reranker-v2-m3-onnx/
MODEL_ALIAS=customer-ops
EMBEDDING_MODEL_ALIAS=bge-m3
RERANK_MODEL_ALIAS=bge-reranker-v2-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_LENGTH=1024
RERANK_MAX_LENGTH=1024
ONNX_THREADS=1
MODEL_SERVER_API_KEY=local-model-server

MODEL_HOST=127.0.0.1
MODEL_PORT=8000
MODEL_CONTEXT_SIZE=4096
MODEL_GPU_LAYERS=0
MODEL_THREADS=0
MODEL_TEMPERATURE=0.2
MODEL_TOP_P=0.8
MODEL_REPEAT_PENALTY=1.1
MODEL_MAX_TOKENS=1024
MODEL_VERBOSE=false
